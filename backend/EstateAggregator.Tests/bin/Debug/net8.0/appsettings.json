{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=data/estate.db"
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "LogFilePath": "Logs/estate-aggregator-.log"
  },
  "Quartz": {
    "MorningCron": "0 0 8 * * ?",
    "EveningCron": "0 0 17 * * ?"
  },
  "Cors": {
    "AllowedOrigin": "http://localhost:3000"
  }
}
