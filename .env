# Frontend
# VITE_API_URL is baked into the client-side bundle and used by the browser,
# not by the frontend container itself — it must be a host-reachable address
# (the port docker-compose publishes), not the internal Docker network
# hostname "backend", which the browser cannot resolve.
VITE_API_URL=/api
# Relative path — vite.config.js proxies /api/* to the backend container over
# the internal Docker network, so the browser only ever talks to whatever
# origin actually served the page (localhost:3001 or a Cloudflare tunnel
# URL). No absolute backend URL to keep in sync with a tunnel, and no
# cross-origin request for the backend's CORS policy to even see.

# Backend
ASPNETCORE_ENVIRONMENT=Development
DATABASE_PATH=/data/estate.db
LOG_FILE_PATH=/app/logs/estate-aggregator-.log

# Scraper Timing (Cron expressions, Quartz.NET format)
SCRAPER_MORNING_CRON=0 0 8 * * ?
SCRAPER_EVENING_CRON=0 0 17 * * ?

# Idealista (via RapidAPI's third-party wrapper — idealista.pt itself blocks
# scraping with DataDome bot protection, see docs/idealista-integration-plan.md).
# Get a key at https://rapidapi.com/kiwimaker/api/idealista-real-estate — the
# Idealista source stays gracefully disabled (reports "Not configured") until
# this is set.
IDEALISTA_RAPIDAPI_KEY=

# WhatsApp contact (Contact Agent panel's "Open in WhatsApp" button) uses
# free wa.me click-to-chat deep links — no account, API key, or paid service
# needed. See frontend/src/utils/messageTemplates.js buildWhatsAppLink().

# AI fact extraction (scripts/ai_extract_facts.py, run automatically after
# every scrape by AiEnrichmentService.cs) — pulls floor/condo fee/pool/garden/
# year built out of listing descriptions using Claude Haiku 4.5, and trims
# the stored description down to whatever's left over. Get a key at
# https://console.anthropic.com/settings/keys. Left unset, this step is
# skipped entirely (logged, not an error) — every other feature works fine
# without it.
ANTHROPIC_API_KEY=
